          "uuid": "385a4f3f-675a-4a31-afb3-96a6c2446104",
          "body": "{\n  \"data\": {\n    \"mountains\": [\n      {\n        \"id\": 10,\n        \"name\": \"가야산\",\n        \"location\": \"경남\",\n        \"elevation\": 1430,\n        \"description\": \"경상남도 합천군과 거창군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 6,\n        \"name\": \"덕유산\",\n        \"location\": \"전북\",\n        \"elevation\": 1614,\n        \"description\": \"전라북도 무주군과 장수군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 1,\n        \"name\": \"무등산\",\n        \"location\": \"광주\",\n        \"elevation\": 1187,\n        \"description\": \"광주광역시와 전라남도 담양군, 화순군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 2,\n        \"name\": \"북한산\",\n        \"location\": \"서울\",\n        \"elevation\": 837,\n        \"description\": \"서울특별시와 경기도에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 4,\n        \"name\": \"설악산\",\n        \"location\": \"강원도\",\n        \"elevation\": 1708,\n        \"description\": \"강원도 속초시, 인제군, 고성군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 9,\n        \"name\": \"소백산\",\n        \"location\": \"충북\",\n        \"elevation\": 1439,\n        \"description\": \"충청북도 단양군과 경상북도 영주시에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 8,\n        \"name\": \"오대산\",\n        \"location\": \"강원도\",\n        \"elevation\": 1563,\n        \"description\": \"강원도 평창군과 강릉시에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 11,\n        \"name\": \"월출산\",\n        \"location\": \"전남\",\n        \"elevation\": 809,\n        \"description\": \"전라남도 영암군과 강진군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 3,\n        \"name\": \"지리산\",\n        \"location\": \"전남\",\n        \"elevation\": 1915,\n        \"description\": \"전라남도, 전라북도, 경상남도에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 7,\n        \"name\": \"태백산\",\n        \"location\": \"강원도\",\n        \"elevation\": 1567,\n        \"description\": \"강원도 태백시와 경상북도 봉화군에 걸쳐 있는 산\"\n      },\n      {\n        \"id\": 5,\n        \"name\": \"한라산\",\n        \"location\": \"제주도\",\n        \"elevation\